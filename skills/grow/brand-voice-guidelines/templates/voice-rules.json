{
  "voice": "<name of the account or character>",
  "version": "1.0.0",
  "updated": "<YYYY-MM-DD>",
  "banned": [
    "guaranteed",
    "100x",
    "to the moon",
    "can't lose",
    "risk-free",
    "easy money",
    "not a bot",
    "I'm human",
    "<a phrase this voice never says>"
  ],
  "avoid": [
    "game-changer",
    "insane",
    "literally obsessed",
    "<an overused word in this niche>"
  ],
  "targetChars": 160,
  "maxChars": 280,
  "emoji": { "max": 1, "allowed": [] },
  "hashtagsMax": 1,
  "exclamationMax": 1,
  "noAllCaps": true,
  "capsAllowed": ["AI", "NFA", "SOL", "ETH", "API", "UK", "EU", "US"],
  "lowercaseStart": false,
  "requireNfaOnCoins": true,
  "requireAiLabel": true,
  "textLabelPlatforms": ["bluesky", "telegram", "discord", "linkedin", "farcaster"],
  "platforms": {
    "x": { "maxChars": 280, "targetChars": 200, "hashtagsMax": 1 },
    "threads": { "maxChars": 500, "targetChars": 280, "hashtagsMax": 1 },
    "bluesky": { "maxChars": 300, "targetChars": 220, "hashtagsMax": 2 },
    "farcaster": { "targetChars": 280, "hashtagsMax": 0 },
    "linkedin": { "maxChars": 3000, "targetChars": 900, "hashtagsMax": 3, "emojiMax": 0 },
    "instagram": { "maxChars": 2200, "targetChars": 300, "hashtagsMax": 5 },
    "tiktok": { "maxChars": 2200, "targetChars": 150, "hashtagsMax": 5 },
    "telegram": { "maxChars": 4096, "targetChars": 600, "hashtagsMax": 0 },
    "newsletter": { "emojiMax": 1, "hashtagsMax": 0 }
  },
  "patterns": [
    { "id": "engagement-bait", "regex": "\\b(like|rt|retweet|repost) (if|to)\\b", "level": "error", "message": "engagement bait: ask a real question instead" },
    { "id": "buy-call", "regex": "\\b(buy|ape|load up)\\b.{0,20}\\b(now|today|before)\\b", "level": "error", "message": "reads as a buy call" },
    { "id": "price-talk", "regex": "\\b(price target|will (pump|moon|double|hit \\$))", "level": "error", "message": "price prediction" },
    { "id": "ai-euphemism", "regex": "\\bai[- ]assisted\\b", "level": "warn", "message": "say 'AI-generated' plainly" }
  ]
}
